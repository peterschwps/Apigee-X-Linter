  "decision": {
    "mode": "development-and-ci",
    "profile": "apigeex",
    "excludedRules": [
      "PO013",
      "PO025"
    ],
    "reason": "Keep apigeelint as an isolated optional comparison/CI tool. It reads saved whole bundles, shares its X/hybrid profile, contains verified catalogue/structure divergences, and adds dependencies unrelated to live XML completion. No runtime dependency or automatic on-save execution is added."
  },
