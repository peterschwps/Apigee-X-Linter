  "sourceGaps": [
    {
      "sourceId": "api-proxy-configuration-reference",
      "rules": [
        "PD005",
        "PD006",
        "TD009",
        "TD010",
        "TD013",
        "TD014",
        "TD016",
        "TD017"
      ],
      "assessment": "Endpoint rules supply comparison candidates, not the missing Resources/TargetServers manifest or ScriptTarget contracts. TLS advice does not resolve the reference's undocumented dependency details."
    },
    {
      "sourceId": "flow-configuration-reference",
      "rules": [
        "ST001",
        "ST002",
        "CC007",
        "FR001",
        "FR002"
      ],
      "assessment": "ST002 overlaps singleton Name/Condition but also tolerates a FaultRules UI artifact. It does not settle contradictory Name requiredness or Description placement. Condition parsing is a separate future bundle feature."
    },
    {
      "sourceId": "load-balancing-across-backend-servers",
      "rules": [
        "TD008",
        "TD009",
        "TD010",
        "TD014",
        "TD015"
      ],
      "assessment": "Fallback overlaps; server cardinality and duplicates are future candidates. Upstream does not resolve weight attribute versus Weight child or Path placement."
    },
    {
      "sourceId": "assign-message-policy",
      "rules": [
        "PO026",
        "PO034",
        "FE001"
      ],
      "assessment": "PO034 omits documented Set/Authentication and treats Properties as empty; this is not an exhaustive current-X schema. The current Google tutorial confirms ReasonPhrase through the shared RaiseFault settings."
    },
    {
      "sourceId": "delete-oauth-v2-info",
      "rules": [],
      "assessment": "No dedicated rule defines the undocumented Attributes stub; known-policy metadata is not a child schema."
    },
    {
      "sourceId": "generate-saml-assertion-policy",
      "rules": [],
      "assessment": "No dedicated rule resolves CanonicalizationAlgorithm or the conflicting OutputVariable sample."
    },
    {
      "sourceId": "http-modifier-policy",
      "rules": [],
      "assessment": "No dedicated rule defines the Properties stub or fixes context-dependent Set/Path behavior."
    },
    {
      "sourceId": "key-value-map-operations-policy",
      "rules": [
        "PO038",
        "PO041"
      ],
      "assessment": "PO038 warns when neither name source is specified, but current documentation explicitly defaults to kvmap. PO041 confirms deprecation guidance only; ExclusiveCache contents remain unspecified."
    },
    {
      "sourceId": "message-validation-policy",
      "rules": [
        "BN013"
      ],
      "assessment": "Resource-use checks do not define the Properties stub or conditional SOAP/XSD schema. Environment resources cannot be proven missing from a local bundle."
    },
    {
      "sourceId": "oas-validation-policy",
      "rules": [
        "BN013"
      ],
      "assessment": "Resource-use checks do not define Properties or validate all OpenAPI semantics; environment resolution remains possible."
    },
    {
      "sourceId": "oauthv2-policy",
      "rules": [
        "PO028",
        "PO029"
      ],
      "assessment": "Metadata recognizes OAuthV2 without defining operation-dependent RSA key, JWKS, or Certificate contracts. A supplemental access-token guide supports the known incomplete Properties stub."
    },
    {
      "sourceId": "populate-cache-policy",
      "rules": [
        "PO030"
      ],
      "assessment": "PO030 warns about multiple expiry options; local requiredness remains separate from documented precedence. Properties contents and deployed-cache existence remain unknown."
    },
    {
      "sourceId": "prompt-token-limit-policy",
      "rules": [
        "PO042"
      ],
      "assessment": "PO042 allows UserPromptSource but omits IgnoreUnresolvedVariables from its allowed-child map despite checking its boolean value later. It accepts false without the X-mode warning; AX110 supplies current documentation guidance."
    },
    {
      "sourceId": "response-cache-policy",
      "rules": [
        "PO024",
        "PO030"
      ],
      "assessment": "PO024 assumes older error-response defaults. PO030 is advisory and cannot override documented expiry precedence. The supplemental corrected example confirms KeyFragment@type but gives no enumeration."
    },
    {
      "sourceId": "service-callout-policy",
      "rules": [
        "PO019",
        "PO020",
        "PO036",
        "PO043",
        "FE001"
      ],
      "assessment": "Response and authentication checks overlap or provide candidates. PO043 uses a helper lacking documented CommonName. Request inheritance, Properties contents, and URL/load-balancer ambiguities remain open."
    },
    {
      "sourceId": "spike-arrest-policy",
      "rules": [
        "PO042"
      ],
      "assessment": "PO042 accepts true/false. Current X documentation calls false unsupported yet uses it in defaults/examples; local AX110 warns without treating the contradictory mode as invalid syntax."
    },
    {
      "sourceId": "trace-capture-policy",
      "rules": [],
      "assessment": "No dedicated rule resolves Variables requiredness, IgnoreUnresolvedVariables defaults, or the summary-only MergeBehavior."
    },
    {
      "sourceId": "validate-saml-assertion-policy",
      "rules": [],
      "assessment": "No dedicated rule resolves deprecated XPath versus current XPath fields or Namespace requiredness."
    },
    {
      "sourceId": "verify-jwt-policy",
      "rules": [],
      "assessment": "PO044 targets GenerateJWT only. VerifyJWT PasswordKey/DirectKey detail and signed algorithm-list key selection are not resolved upstream."
    },
    {
      "sourceId": "xml-threat-protection-policy",
      "rules": [
        "ST007"
      ],
      "assessment": "ST007 checks policy attachment/content conditions, not StructuralLimits/StructureLimits or ChildCount attribute spelling."
    },
    {
      "sourceId": "oauth-access-tokens-guide",
      "rules": [
        "PO028",
        "PO029"
      ],
      "assessment": "Supplemental Properties stub is accepted but its child/attribute structure is still unknown."
    },
    {
      "sourceId": "flow-basics-guide",
      "rules": [],
      "assessment": "Supplemental VerifyAPIKey Properties stub has no documented child/attribute structure."
    },
    {
      "sourceId": "extractvariables-deployment-errors",
      "rules": [
        "PO033"
      ],
      "assessment": "Extraction hygiene does not define the supplemental Properties stub."
    },
    {
      "sourceId": "quota-deployment-errors",
      "rules": [
        "PO035"
      ],
      "assessment": "PO035 accepts empty Properties but does not establish a general Properties content contract."
    }
  ],
  "findings": [
    {
      "id": "expiry-advice",
      "rules": [
        "PO030"
      ],
      "decision": "Keep upstream warnings separate from AX107 configuration errors.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/populate-cache-policy#ExpirySettingsElement",
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/response-cache-policy#expirysettingselement"
      ],
      "detail": "The implementation's severity is warning; multiple expiry options have documented precedence."
    },
    {
      "id": "kvm-default",
      "rules": [
        "PO038"
      ],
      "decision": "Do not require an explicit map name as a local error.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/key-value-map-operations-policy#keyvaluemapoperations_attributes"
      ],
      "detail": "When both mapIdentifier and MapName are absent, current documentation says kvmap is used."
    },
    {
      "id": "generate-jwt-incomplete-allowlist",
      "rules": [
        "PO044"
      ],
      "decision": "Keep the reviewed local shape.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/generate-jwt-policy"
      ],
      "detail": "The published plugin's allowedChildren omits DirectKey, Compress, Type, and ignored CustomClaims. It is not a complete current GenerateJWT schema."
    },
    {
      "id": "policy-catalogue",
      "rules": [
        "PO028",
        "PO029"
      ],
      "decision": "Do not use upstream policy metadata as the authoritative X inventory.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/parse-payload-policy"
      ],
      "detail": "The pinned package's policyMetaData.json lacks ParsePayload, which the current X reference and local rules support."
    },
    {
      "id": "documented-tokens",
      "rules": [
        "PO034"
      ],
      "decision": "Retain AssignMessage/Set/Authentication.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/assign-message-policy"
      ],
      "detail": "The plugin's Set allowlist omits Authentication; the current reference documents it."
    },
    {
      "id": "ssl-common-name",
      "rules": [
        "PO043"
      ],
      "decision": "Retain documented SSLInfo/CommonName.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/api-proxy-configuration-reference"
      ],
      "detail": "The shared upstream SSLInfo helper omits CommonName, which is present in the current TargetEndpoint TLS reference."
    },
    {
      "id": "sample-whitespace",
      "rules": [],
      "decision": "Retain the documented flow-name format error and record the sample discrepancy.",
      "evidence": [
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/flow-configuration-reference"
      ],
      "detail": "json-web-tokens/proxies/default.xml uses Flow name='unknown request'. The current name reference forbids whitespace; passing apigeelint is not deployment evidence."
    }
  ],
